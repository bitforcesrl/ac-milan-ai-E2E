{
	"mcpServers": {
		"playwright": {
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@latest"
			],
			"env": {
				"PLAYWRIGHT_MCP_BROWSER": "webkit",
				"PLAYWRIGHT_MCP_ISOLATED": "true",
				"PLAYWRIGHT_MCP_DEVICE": "iPhone 13 Pro Max"
			},
			"alwaysAllow": [
				"*"
			]
		}
	}
}