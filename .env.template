# Variabili per eseguire la run E2E in LOCALE (equivalente dei parametri della pipeline Azure).
# Uso: npm run e2e:ci
# NB: in CI Azure queste variabili vengono passate dalla pipeline e sovrascrivono questo file.

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_AI_MODEL=qwen/qwen3.7-plus
OPENROUTER_MAX_RETRIES=5
OPENROUTER_RETRY_BASE_MS=2000
OPENROUTER_MAX_TURNS=300

# --- Browser selezionati (true/false) ---
RUN_CHROMIUM=true
RUN_FIREFOX=false
RUN_WEBKIT=false

# --- Viewport selezionati (true/false) ---
# desktop=1280x650, tablet=768x1024, mobile=390x844
RUN_DESKTOP=true
RUN_TABLET=false
RUN_MOBILE=false

# --- MCP ---
# Timeout (ms) per ogni chiamata tool MCP
MCP_TOOL_TIMEOUT=180000
