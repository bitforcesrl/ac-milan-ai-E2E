# Variabili per eseguire la run E2E in LOCALE (equivalente dei parametri della pipeline Azure).
# Uso: npm run e2e:ci
# NB: in CI Azure queste variabili vengono passate dalla pipeline e sovrascrivono questo file.

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_AI_MODEL=qwen/qwen3.7-plus
OPENROUTER_MAX_RETRIES=5
OPENROUTER_RETRY_BASE_MS=2000
OPENROUTER_MAX_TURNS=300

# --- Browser selezionati (true/false) ---
RUN_CHROMIUM=true
RUN_FIREFOX=false
RUN_WEBKIT=false

# --- Viewport selezionati (true/false) ---
# desktop=1280x650, tablet=768x1024, mobile=390x844
RUN_DESKTOP=true
RUN_TABLET=false
RUN_MOBILE=false

# --- Test selezionati ---
# Un flag booleano per ogni test definito in config.js: TEST_ + id in SNAKE_CASE.
# Se almeno un flag e' definito, SOLO i flag a true determinano i test eseguiti.
# Se nessun flag e' definito, vengono eseguiti i test con enabled: true in config.js.
TEST_FAIL_TEST=false
TEST_PDP=false
TEST_PDP_FUZZY=false
TEST_QUICKBUY_COMBINATIONS=false
TEST_QUICKBUY_PERSONALIZATION=false
TEST_QUICKBUY_CART_VALIDATION=true

# --- MCP ---
# Timeout (ms) per ogni chiamata tool MCP
MCP_TOOL_TIMEOUT=180000

# --- Parallelismo ---
# Numero massimo di sessioni) eseguite contemporaneamente.
MAX_PARALLEL_SESSIONS=1

# --- Azure Blob (per la dashboard Next.js: npm run dev → /reports) ---
# Connection string dell'account di storage che contiene i report.
# NB: usata SOLO lato server (Server Components); al client espongono solo URL SAS.
AZURE_STORAGE_CONNECTION_STRING=
# Container dei report (default: e2e-reports)
AZURE_STORAGE_CONTAINER=e2e-reports
# Prefisso dei report sul container (default: e2e, come BLOB_PREFIX in config.js)
REPORT_BLOB_PREFIX=e2e
# Validità in giorni delle SAS generate per screenshot/asset (default: 90)
REPORT_SAS_DAYS=90
