
# --- Branding ---
NEXT_PUBLIC_CLIENT_NAME=Client Name

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MAX_RETRIES=5
OPENROUTER_RETRY_BASE_MS=2000
OPENROUTER_MAX_TURNS=300


# --- Protezione dashboard (password + sessione) ---
# Password richiesta per accedere alla dashboard Next.js
APP_PASSWORD=
# Segreto usato per firmare il cookie di sessione (qualsiasi stringa random lunga, es. `openssl rand -hex 32`)
APP_SESSION_SECRET=
# Durata della sessione in ore (default: 168 = 7 giorni)
APP_SESSION_TTL_HOURS=168

# --- Azure Blob (per la dashboard Next.js: npm run dev → /reports) ---
AZURE_STORAGE_CONNECTION_STRING=
# Container dei report (default: e2e-reports)
AZURE_STORAGE_CONTAINER=e2e-reports

# --- Azure DevOps (per triggerare la pipeline E2E dalla dashboard: POST /api/trigger-pipeline) ---
# Organizzazione e progetto Azure DevOps
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
# ID della definizione di build (pipeline) da eseguire
AZURE_DEVOPS_PIPELINE_ID=
# Personal Access Token con permesso "Build (Read & Execute)"
AZURE_DEVOPS_PAT=
# Branch su cui eseguire la pipeline (default: main)
AZURE_DEVOPS_BRANCH=main

# --- Email report (scripts/send-email-report.mjs) ---
# API key SendGrid
EMAIL_SENDGRID_API_KEY=
# Mittente della mail di report
EMAIL_FROM=
# URL della pagina HTML del report da includere
EMAIL_REPORT_HTML_URL=
